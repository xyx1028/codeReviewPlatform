{
  "$comment": [
    "V4 Harness Manifest：这是当前 Harness 能力与默认策略的唯一人工维护入口。",
    "升级 @deepseek-ai/dsh 时，先更新本文件，再运行 npm run harness:manifest:new-migration -- <下一个迁移编号>",
    "生成数据库部署副本；npm run harness:manifest:check 会阻止配置、依赖和迁移漂移。",
    "任何 Harness 升级带来的插件或工具增删都必须显式修改本文件，否则契约测试 fail closed。"
  ],
  "manifestRevision": 1,
  "contractVersion": 4,
  "harnessVersion": "0.1.5-rc.1",
  "bundles": ["@deepseek-ai/dsh-base", "@deepseek-ai/dsh-acp-app"],

  "$comment_default_policy": [
    "defaultPolicy：平台统一默认策略。Worker 的默认值和管理页面展示均以此为源。",
    "数据库只保存由本 manifest 生成的版本化部署副本；不要手工修改生成的策略 JSON。"
  ],
  "defaultPolicy": {
    "version": 4,
    "capabilities": {
      "instructions": true,
      "skills": true,
      "goal": true,
      "plan": true,
      "todo": true,
      "ralph": true,
      "subagentSpawn": true,
      "subagentFork": true,
      "subagentControl": true,
      "workflow": true,
      "jobs": true,
      "shell": true,
      "filesystem": true,
      "webSearch": true,
      "webFetch": true,
      "parallelTools": true,
      "autoCompaction": true,
      "sessionPersistence": true,
      "sessionResume": true,
      "artifacts": true
    },
    "sandbox": {
      "defaultMode": "workspace-write",
      "dangerFullAccess": false,
      "commandTimeoutMs": 60000,
      "maxProcessesPerAttempt": 64,
      "maxWorkspaceBytes": 2147483648,
      "maxWorkspaceFiles": 100000
    },
    "agents": {
      "maxAgentsPerAttempt": 8,
      "maxDelegationDepth": 2,
      "maxConcurrentChildren": 4,
      "allowOutOfProcessProviders": false
    },
    "workflow": { "maxConcurrentSteps": 4, "maxRuntimeMs": 900000 },
    "jobs": { "maxConcurrentJobsPerOwner": 4, "maxRuntimeMs": 300000 },
    "parallelTools": { "maxPerStep": 8, "mutationToolsSerial": true },
    "modelBudget": {
      "maxTotalRequests": 160,
      "maxRootRequests": 80,
      "maxChildRequests": 32,
      "maxRetryRequests": 12,
      "maxCompactionRequests": 8,
      "maxRalphRounds": 12
    },
    "web": {
      "maxRequestsPerAttempt": 20,
      "maxResponseBytes": 2097152,
      "maxTotalBytes": 20971520,
      "allowHttp": false,
      "allowedPorts": [443],
      "allowedDomains": [],
      "denyPrivateNetworks": true,
      "maxRedirects": 3,
      "requestTimeoutMs": 20000
    },
    "session": {
      "checkpointEveryEvents": 100,
      "retentionDays": 7,
      "encryptAtRest": true,
      "resumeOnWorkerRestart": true
    }
  },

  "$comment_plugins": [
    "enabledPlugins：V4 默认必须处于启用状态的 base/acp bundle 行。缺任何一行都说明 profile",
    "被改坏或 Harness 换了 id，属于 fail closed。"
  ],
  "enabledPlugins": [
    "agent-instructions",
    "skill",
    "skill-filesystem",
    "skill-badge",
    "tool-skill",
    "commands",
    "command-feedback",
    "command-goal",
    "command-compact",
    "goal",
    "goal-round-driver",
    "tool-goal",
    "plan-mode",
    "tool-todo",
    "tool-ralph",
    "subagent",
    "subagent-spawn-in-process",
    "subagent-fork-in-process",
    "tool-subagent",
    "tool-subagent-fork",
    "tool-subagent-control",
    "tool-subagent-list-agents",
    "workflow-worker-thread",
    "tool-workflow",
    "jobs",
    "tool-jobs",
    "subprocess",
    "sandbox",
    "sandbox-policy",
    "bash-sandbox",
    "shell-env",
    "tool-bash",
    "fs-observation-policy",
    "fs-sandbox",
    "tool-fs",
    "tool-fs-search",
    "web",
    "token-meter",
    "compaction-basic",
    "tool-result-pruner",
    "session-checkpoint-policy",
    "session-persistence-jsonl",
    "spill-local",
    "spill-policy",
    "repeat-tool-reminder",
    "timeout-policy",
    "llm",
    "llm-pi-ai",
    "llm-retry",
    "deepseek-llm-api-extensions",
    "agent",
    "agent-loop",
    "agent-default-model",
    "tools",
    "system-prompt",
    "session",
    "acp"
  ],

  "$comment_disabled": [
    "disabledPlugins：本方案第 1.4 节列出的“不属于全能力”的项目。它们必须保持禁用：",
    "重复的 adapter、外部 telemetry、OS 不兼容的 Shell、以及被平台自有实现替换掉的出口。"
  ],
  "$comment_web": [
    "tool-web / web-search-deepseek / web-fetch-http 被禁用，不是因为关闭 Web 能力，而是因为",
    "它们在 Harness 进程里直接发请求。模型看到的工具名 web_search / web_fetch 由平台插件",
    "platform-web 提供，出口经过 Worker 的 allowlist、DNS 复查、逐跳 redirect 校验和字节配额。",
    "能力仍然默认开启，只有出口换了主人。"
  ],
  "disabledPlugins": [
    "llm-deepseek",
    "session-telemetry-otel",
    "web-search-deepseek",
    "web-fetch-http",
    "tool-web",
    "pwsh-sandbox",
    "tool-pwsh",
    "hmr",
    "session-title-llm"
  ],

  "$comment_platform": [
    "platformPlugins：平台自有插件。它们承载治理面（身份、预算、web 出口、usage 上报、",
    "快照工具、提交工具），不属于 Harness base bundle。"
  ],
  "platformPlugins": [
    "agent-authority-policy",
    "usage-reporter",
    "platform-web",
    "snapshot-tools",
    "review-control-tool"
  ],

  "$comment_tools": [
    "modelTools：模型上下文里允许出现的工具名全集。resolved inventory 出现任何不在此列的",
    "工具名 → UNKNOWN_TOOL → attempt fail closed。schemaHash 是工具参数契约的摘要，由",
    "contract test 按 defineTool 声明重算并比对，用来发现 Harness 升级悄悄改了参数。"
  ],
  "modelTools": {
    "search_snapshot_code": { "origin": "platform", "mutating": false, "parallelSafe": true },
    "find_snapshot_files": { "origin": "platform", "mutating": false, "parallelSafe": true },
    "read_snapshot_code": { "origin": "platform", "mutating": false, "parallelSafe": true },
    "list_snapshot_commits": { "origin": "platform", "mutating": false, "parallelSafe": true },
    "submit_review_result": { "origin": "platform", "mutating": true, "parallelSafe": false },
    "skill": { "origin": "harness", "mutating": false, "parallelSafe": true },
    "todo_write": { "origin": "harness", "mutating": true, "parallelSafe": false },
    "create_goal": { "origin": "harness", "mutating": true, "parallelSafe": false },
    "update_goal": { "origin": "harness", "mutating": true, "parallelSafe": false },
    "get_goal": { "origin": "harness", "mutating": false, "parallelSafe": true },
    "ralph": { "origin": "harness", "mutating": true, "parallelSafe": false },
    "subagent": { "origin": "harness", "mutating": true, "parallelSafe": false },
    "subagent_fork": { "origin": "harness", "mutating": true, "parallelSafe": false },
    "send_message": { "origin": "harness", "mutating": true, "parallelSafe": false },
    "interrupt_agent": { "origin": "harness", "mutating": true, "parallelSafe": false },
    "list_agents": { "origin": "harness", "mutating": false, "parallelSafe": true },
    "workflow": { "origin": "harness", "mutating": true, "parallelSafe": false },
    "job_list": { "origin": "harness", "mutating": false, "parallelSafe": true },
    "job_output": { "origin": "harness", "mutating": false, "parallelSafe": true },
    "job_kill": { "origin": "harness", "mutating": true, "parallelSafe": false },
    "bash": { "origin": "harness", "mutating": true, "parallelSafe": false },
    "read": { "origin": "harness", "mutating": false, "parallelSafe": true },
    "read_image": { "origin": "harness", "mutating": false, "parallelSafe": true },
    "write": { "origin": "harness", "mutating": true, "parallelSafe": false },
    "edit": { "origin": "harness", "mutating": true, "parallelSafe": false },
    "grep": { "origin": "harness", "mutating": false, "parallelSafe": true },
    "glob": { "origin": "harness", "mutating": false, "parallelSafe": true },
    "web_search": { "origin": "harness", "mutating": false, "parallelSafe": true },
    "web_fetch": { "origin": "harness", "mutating": false, "parallelSafe": true },
    "exit_plan_mode": { "origin": "harness", "mutating": false, "parallelSafe": false }
  },

  "$comment_roles": [
    "roleTools：本方案 4.1 节权限矩阵的机器可读形式。root 拥有完整编排面；子 Agent 只拿",
    "当前任务需要的工具。submit_review_result 只出现在 root-reviewer。",
    "有效权限 = 全局 policy ∩ role ∩ child toolFilter ∩ Broker 强制授权 ∩ lease/budget 状态。"
  ],
  "roleTools": {
    "root-reviewer": [
      "search_snapshot_code",
      "find_snapshot_files",
      "read_snapshot_code",
      "list_snapshot_commits",
      "submit_review_result",
      "skill",
      "todo_write",
      "create_goal",
      "update_goal",
      "get_goal",
      "ralph",
      "subagent",
      "subagent_fork",
      "send_message",
      "interrupt_agent",
      "list_agents",
      "workflow",
      "job_list",
      "job_output",
      "job_kill",
      "bash",
      "read",
      "read_image",
      "write",
      "edit",
      "grep",
      "glob",
      "web_search",
      "web_fetch",
      "exit_plan_mode"
    ],
    "research-child": [
      "search_snapshot_code",
      "find_snapshot_files",
      "read_snapshot_code",
      "list_snapshot_commits",
      "skill",
      "todo_write",
      "read",
      "read_image",
      "grep",
      "glob",
      "web_search",
      "web_fetch",
      "subagent",
      "list_agents",
      "exit_plan_mode"
    ],
    "implementation-child": [
      "search_snapshot_code",
      "find_snapshot_files",
      "read_snapshot_code",
      "list_snapshot_commits",
      "skill",
      "todo_write",
      "read",
      "read_image",
      "write",
      "edit",
      "grep",
      "glob",
      "bash",
      "job_list",
      "job_output",
      "job_kill",
      "exit_plan_mode"
    ],
    "critic-child": [
      "search_snapshot_code",
      "find_snapshot_files",
      "read_snapshot_code",
      "list_snapshot_commits",
      "skill",
      "read",
      "read_image",
      "grep",
      "glob",
      "web_search",
      "web_fetch",
      "exit_plan_mode"
    ],
    "workflow-child": [
      "search_snapshot_code",
      "find_snapshot_files",
      "read_snapshot_code",
      "list_snapshot_commits",
      "skill",
      "todo_write",
      "read",
      "read_image",
      "write",
      "edit",
      "grep",
      "glob",
      "bash",
      "job_list",
      "job_output",
      "job_kill",
      "web_search",
      "web_fetch",
      "exit_plan_mode"
    ]
  },

  "$comment_broker": [
    "brokerRoutes：Broker 承认的路由，以及每条路由要求的最小 role 能力。模型侧工具名与",
    "Broker 路由是两套命名，两边都要冻结，否则新增一条路由就能绕过角色策略。"
  ],
  "brokerRoutes": {
    "/attempt/search-code": { "capability": "snapshotRead", "mutating": false },
    "/attempt/find-files": { "capability": "snapshotRead", "mutating": false },
    "/attempt/read-code": { "capability": "snapshotRead", "mutating": false },
    "/attempt/list-commits": { "capability": "snapshotRead", "mutating": false },
    "/attempt/snapshot-pins": { "capability": "snapshotRead", "mutating": false },
    "/attempt/register-agent": { "capability": "agentRegister", "mutating": true },
    "/attempt/finish-agent": { "capability": "agentRegister", "mutating": true },
    "/attempt/report-usage": { "capability": "usageReport", "mutating": true },
    "/attempt/reserve-model-request": { "capability": "usageReport", "mutating": true },
    "/attempt/web-egress": { "capability": "webEgress", "mutating": false },
    "/attempt/save-artifact": { "capability": "artifactWrite", "mutating": true },
    "/attempt/tool-audit": { "capability": "usageReport", "mutating": true },
    "/attempt/submit-review": { "capability": "submitReview", "mutating": true }
  },

  "$comment_errors": [
    "errorCodes：本方案第 9 节要求的稳定错误码。UI 与运维按码分类，消息一律脱敏。"
  ],
  "errorCodes": [
    "AGENT_IDENTITY_INVALID",
    "AGENT_ROLE_DENIED",
    "SUBMIT_ROOT_ONLY",
    "AGENT_TREE_LIMIT_EXCEEDED",
    "AGENT_TREE_CANCELLED",
    "MODEL_BUDGET_EXHAUSTED",
    "TOOL_BUDGET_EXHAUSTED",
    "WORKSPACE_POLICY_DENIED",
    "WEB_EGRESS_DENIED",
    "SESSION_FENCED",
    "SESSION_FORMAT_UNSUPPORTED",
    "SESSION_RECOVERY_FAILED",
    "EVIDENCE_AGENT_INVALID",
    "EVIDENCE_ORIGIN_INVALID",
    "ATTEMPT_ALREADY_SEALED",
    "PROCESS_TREE_CLEANUP_FAILED"
  ]
}
