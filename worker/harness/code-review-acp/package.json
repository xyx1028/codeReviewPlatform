{
  "name": "code-review-acp-profile",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "DeepSeek Harness profile for one V4 code-review attempt over ACP: all capabilities on, every capability governed.",
  "dsh": {
    "profile": {
      "bundles": [
        "@deepseek-ai/dsh-base",
        "@deepseek-ai/dsh-acp-app"
      ],
      "patchReload": "startup"
    }
  },
  "dependencies": {
    "@codereview/harness-agent-authority-policy": "*",
    "@codereview/harness-usage-reporter": "*",
    "@codereview/harness-platform-web": "*",
    "@codereview/harness-snapshot-tools": "*",
    "@codereview/harness-review-control-tool": "*"
  }
}
