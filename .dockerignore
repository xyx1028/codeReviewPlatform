# Keep the worker image small and secret-free.
node_modules
dist
dist-ssr
dist-worker
# Vendored Harness sources are an audit reference only; the worker consumes the
# published @deepseek-ai packages from node_modules.
deepseekharness
.git
.idea
.vscode
*.log
.env
.env.*
.docker/worker.env
!.env.example
src
public
supabase/*
!supabase/migrations/
!supabase/migrations/*.sql
代码评审平台
coverage
*.local
.DS_Store
README.md
vite.config.ts
tsconfig.app.json
tsconfig.node.json
index.html

# The Worker image intentionally excludes the browser source tree.  The
# company Web Dockerfile needs these files to build the Vite SPA, while the
# secret-bearing .env files above remain excluded for every image.
!src/
!src/**
!public/
!public/**
!index.html
!vite.config.ts
!tsconfig.json
!tsconfig.app.json
!tsconfig.node.json
!Dockerfile.workercompany
!worker/
!worker/harness/
!worker/harness/**
!supabase/
!supabase/migrations/
!supabase/migrations/**
