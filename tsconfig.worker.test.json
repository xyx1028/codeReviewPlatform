{
  // 测试文件的类型检查。
  //
  // tsconfig.worker.json 刻意排除 *.test.ts（它们不该被编译进 dist-worker），
  // 后果是测试里的类型错误从来没人管：假的 JobsDb 可以和真接口静默漂移，
  // WorkerConfig 字面量可以缺字段。曾因此漏掉一个真实故障（prepare-job 调用了
  // 被 legacy fencing 挡住的 v1 RPC，导致 ACP Job 卡在 PREPARING_CODE）。
  //
  // 这份配置只做检查、不产出文件。
  "extends": "./tsconfig.worker.json",
  "compilerOptions": {
    "noEmit": true,
    // 这份配置只做检查、不产出文件，所以 rootDir 放宽到仓库根。
    //
    // 必要性很具体：Worker 与 Edge Function 的归档校验器是**故意重复**的两份实现
    // （见 worker/src/__tests__/v16-skill-validator-parity.test.ts 的说明），而那份等价性
    // 测试要同时 import 两边。继承 tsconfig.worker.json 的 `rootDir: ./worker/src` 会以
    // TS6059 拒绝 `supabase/functions/**`，于是"两份实现是否还等价"就永远没人检查。
    "rootDir": "."
  },
  "include": ["worker/src/**/*.ts"],
  "exclude": ["node_modules", "dist-worker"]
}
