{
  "name": "codereviewplatform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run harness:manifest:check && tsc -b && vite build",
    "lint": "oxlint src worker supabase scripts",
    "preview": "vite preview",
    "worker:dev": "tsx worker/src/index.ts",
    "worker:build": "npm run harness:manifest:check && tsc -p tsconfig.worker.json",
    "worker:typecheck": "tsc -p tsconfig.worker.test.json",
    "web:typecheck": "tsc -p tsconfig.web.test.json",
    "worker:start": "node dist-worker/index.js",
    "worker:check-connectivity": "node dist-worker/connectivity-check.js",
    "harness:manifest:check": "node scripts/v4-harness-manifest.mjs check",
    "version:check": "node scripts/check-product-version-sync.mjs",
    "harness:manifest:new-migration": "node scripts/v4-harness-manifest.mjs generate-migration",
    "test:worker": "npm run harness:manifest:check && vitest run worker",
    "test:web": "vitest run -c vitest.web.config.ts",
    "test": "npm run harness:manifest:check && vitest run",
    "monitor:attempt": "node scripts/runtime-report.mjs attempt",
    "monitor:trend": "node scripts/runtime-report.mjs trend",
    "monitor:findings": "node scripts/runtime-report.mjs findings",
    "proxy:model-vpn": "node scripts/model-vpn-proxy.mjs",
    "proxy:model-vpn:install": "bash scripts/install-model-vpn-proxy.sh",
    "proxy:model-vpn:uninstall": "bash scripts/uninstall-model-vpn-proxy.sh",
    "worker:release": "bash scripts/worker-drain-restart.sh",
    "worker:drain": "bash scripts/worker-drain-restart.sh --drain-only",
    "worker:drain:lift": "bash scripts/worker-drain-restart.sh --lift-only",
    "db:backup:local": "bash scripts/backup-local-db.sh"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh": "0.1.5-rc.1",
    "@deepseek-ai/dsh-app-boot": "0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.1",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.5-rc.1",
    "@deepseek-ai/dsh-session": "0.1.5-rc.1",
    "@deepseek-ai/dsh-session-persistence": "0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.1",
    "@deepseek-ai/schemastery": "3.18.2",
    "@supabase/supabase-js": "^2.115.0",
    "@tanstack/react-query": "^5.102.8",
    "antd": "^6.6.3",
    "dayjs": "^1.11.23",
    "diff": "9.0.0",
    "fflate": "0.8.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "read-excel-file": "^9.3.10",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "tsx": "4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "5.0.0"
  }
}
