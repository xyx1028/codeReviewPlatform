# 远程 MCP 服务配置示例。复制成 .env 后填写。
#
# 启动时会自动加载**本目录**的 .env（`npm run mcp:start` / `npm start` 都一样），
# 不需要再 `set -a && . ./.env`。真实环境变量优先：容器用 --env-file、systemd 用
# EnvironmentFile 注入时，不会被这份文件盖掉。要指定别的路径用 CRP_MCP_ENV_FILE。
#
# .env 不要入库（根 .gitignore 已忽略 mcp/**/.env）。

# ---- 平台取数通道（只用 anon key，绝不要填 service-role key）----
CRP_SUPABASE_URL=
CRP_SUPABASE_ANON_KEY=

# ---- 代表这台 MCP 的平台账号（角色必须是 ADMIN 或 REVIEWER）----
CRP_EMAIL=
CRP_PASSWORD=

# ---- 平台前端地址，用于拼批次详情链接 ----
CRP_PLATFORM_WEB_URL=https://review.example.com

# ---- 评审模型（展示名或 id）。平台有多个可用模型时必填 ----
CRP_DEFAULT_MODEL=

# ---- 远程 MCP 端点 ----
CRP_MCP_TRANSPORT=http
CRP_MCP_HOST=0.0.0.0
CRP_MCP_PORT=8848
CRP_MCP_PATH=/mcp

# ---- 访问凭证：名字:至少16位随机串，逗号分隔。名字只写进日志，用来区分谁提交的 ----
# 生成：node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
CRP_MCP_TOKENS=

# ---- 仅内网自测时才打开；为 true 时任何能访问端口的人都能提交评审并消耗模型额度 ----
CRP_MCP_ALLOW_NO_AUTH=false

# ---- 批次名前缀 ----
CRP_BATCH_NAME_PREFIX=MCP 评审

# ---- 发布周期编码所用时区。必须与平台页面上「创建时间」的时区一致，
#      否则编码会比创建时间差几个小时（容器通常是 UTC），早上 08:00 前提交还会错一天 ----
CRP_TIMEZONE=Asia/Shanghai

# ---- 提交前核对需求（强烈建议保持默认开启）----
# 作用：按需求编号反查它真正所属的项目组，核对编号是否存在，并在提交前把需求信息
#       交给用户确认。不开启的话，参数写错要等平台侧导入失败才会发现。
# 未设置时用公司默认地址；显式设成空字符串才关闭核对。
CRP_LINKY_API_BASE_URL=https://feature.kingdee.com:2055/quality-platform/api/linky
CRP_LINKY_TIMEOUT_MS=8000

# ---- 确认令牌：提交必须先经用户确认，令牌是这道门禁的服务端凭据 ----
# CRP_CONFIRM_SECRET 留空则每次启动随机生成（重启后旧令牌失效）。
# 多实例部署必须显式配置同一个值，否则 A 实例签的令牌到 B 实例会被拒。
CRP_CONFIRM_TTL_MS=900000
# CRP_CONFIRM_SECRET=

# ---- 可选：显式指定 .env 路径（相对路径按启动时的工作目录解析）----
# CRP_MCP_ENV_FILE=/etc/codereview-mcp/.env

# ---- 可选：浏览器来源白名单（逗号分隔）。默认 * ----
# 只影响 CORS 响应头，不替代鉴权：凭证走 Authorization 头而不是 cookie。
# 在 IDE WebView 里跑的客户端需要预检通过，所以默认放开。
# CRP_MCP_ALLOWED_ORIGINS=https://ide.example.com

# ---- 可选：空闲会话回收。Streamable HTTP 的会话只在客户端显式 DELETE 时才关闭，
#      而多数客户端进程退出时不发 DELETE，不回收会无上限堆积 ----
CRP_MCP_SESSION_TTL_MS=1800000
CRP_MCP_MAX_SESSIONS=256

# ---- 可选：超时预算。四项要一起看，最坏路径必须小于调用方客户端的超时（多数默认 60 秒）：
#      CRP_PLATFORM_TIMEOUT_MS + CRP_SETTLE_PROBES × CRP_SETTLE_PROBE_TIMEOUT_MS
#        + (CRP_SETTLE_PROBES - 1) × CRP_SETTLE_DELAY_MS
#      默认 20000 + 3×8000 + 2×2000 = 48 秒 ----
CRP_PLATFORM_TIMEOUT_MS=20000
CRP_SETTLE_PROBES=3
CRP_SETTLE_PROBE_TIMEOUT_MS=8000
CRP_SETTLE_DELAY_MS=2000
