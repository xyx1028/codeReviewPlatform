# 自部署 Supabase 的 .env 中**非秘密**部分（V1.48）
#
# 官方 .env.example 里的秘密项（POSTGRES_PASSWORD / JWT_SECRET / ANON_KEY /
# SERVICE_ROLE_KEY / DASHBOARD_PASSWORD / SECRET_KEY_BASE / VAULT_ENC_KEY 等）
# 由服务器上的 utils/generate-keys.sh 生成，**不进这个仓库，也不要贴到聊天里**。
#
# 把下面这些键合并进 /srv/crp/supabase/.env：

COMPOSE_PROJECT_NAME=crp-selfhost
COMPOSE_FILE=docker-compose.yml:docker-compose.crp.yml

# 公司浏览器访问的外部地址。错一个字母的后果是：登录邮件链接、文件签名 URL、
# OAuth 回调全部指向打不开的地址，而页面本身看起来是好的。
SUPABASE_PUBLIC_URL=https://crp-supabase.kingdee.com
API_EXTERNAL_URL=https://crp-supabase.kingdee.com
SITE_URL=https://crp-review.kingdee.com
ADDITIONAL_REDIRECT_URLS=

# 连接池租户标识。改了它，pooler 的用户名（postgres.<POOLER_TENANT_ID>）也跟着变。
POOLER_TENANT_ID=crp-selfhost

# 容器内部端口，宿主机映射由 docker-compose.crp.yml 收到回环
POSTGRES_PORT=5432
POOLER_PROXY_PORT_TRANSACTION=6543

# 首轮由管理员预置账号，不开放自助注册（开放注册 + 无 SMTP = 没人能确认邮箱）。
# 实测：DISABLE_SIGNUP=true 时 /auth/v1/signup 返回 422，预置账号走
# POST /auth/v1/admin/users（service-role）+ 平台的 claim_initial_admin。
DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false

# 注意：**没有** FILE_SIZE_LIMIT 这个 .env 键。
# v0.8.2 把它写死在 docker-compose.yml 的 storage 服务里（`FILE_SIZE_LIMIT: 52428800`＝50MB）。
# 往 .env 里写它是静默无效的；要改就在 docker-compose.crp.yml 里覆盖 storage 的 environment，
# 并同步改 nginx 的 client_max_body_size。
