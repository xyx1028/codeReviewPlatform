# 前端自部署构建配置模板（V1.48）
#
# 复制到仓库根目录的 .env.selfhost.local，然后：
#   npm run build:selfhost        # 等价于 vite build --mode selfhost
#   把 dist/ 发到静态服务（见 nginx/review.conf）
#
# ⚠️ Vite 是**构建时**把这些值写进产物的。换域名或换 key 之后必须重新构建；
#    改服务器上的 .env 文件不会生效，页面还会连旧地址。
# ⚠️ 这两个值都会进浏览器，所以只能放 anon key。service-role key 进了前端等于公开数据库。

# 公司浏览器能访问的 Supabase 外部地址（经反向代理 + HTTPS），不是 Docker 服务名
VITE_SUPABASE_URL=https://supabase.corp.example

# 新实例的 anon key（Supabase 自部署 .env 里的 ANON_KEY）
VITE_SUPABASE_ANON_KEY=

# 微信扫码登录：首轮不接（需要公网可达的 OAuth 回调）
VITE_WECHAT_LOGIN_ENABLED=false

# Linky 取数接口。看板由**浏览器直连**它，所以使用者必须在公司内网/VPN 里。
# 留空用代码默认值 https://feature.kingdee.com:2055/quality-platform/api/linky
VITE_LINKY_API_BASE_URL=
