# Worker 自部署配置模板（V1.48）
#
# 复制到 .docker/worker.selfhost.env 填写，再用 deploy/supabase-selfhost/worker.override.yml 启动。
# 这个文件带 service-role key 与 GitLab/代理凭据，**绝不能提交**（.gitignore 已忽略 .docker/*.env）。

# ---------------------------------------------------------------------------
# 内网 Supabase。走 Compose 共享网络的服务别名，不经反向代理、不用 host.docker.internal
# （后者是 Docker Desktop 的东西，Linux 上不存在）。
# ---------------------------------------------------------------------------
SUPABASE_URL=http://crp-supabase-api:8000
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# 公司部署默认 4 副本，每副本并发处理 2 条需求，15 秒轮询。
# company override 明确设为 2，旧 env_file 的值不会覆盖它。
# ---------------------------------------------------------------------------
POLL_INTERVAL_MS=15000
WORKER_STORY_CONCURRENCY=2
STORY_TASK_LEASE_SECONDS=1800
HEARTBEAT_INTERVAL_MS=30000
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# GitLab（代码快照）。其余可选项见 .docker/worker.env.example。
# ---------------------------------------------------------------------------
GIT_AUTH_MODE=token
GITLAB_BASE_URL=
GITLAB_DEPLOY_USER=
GITLAB_DEPLOY_TOKEN=
GITLAB_API_TOKEN=

# ---------------------------------------------------------------------------
# Linky 需求导入。
# 公司 Linux 服务器在内网里、容器能直连公司接口时用 DIRECT；
# 需要翻代理才用 HOST_PROXY，并把下面的代理指向**这台服务器可达**的代理，
# 不要照抄 Mac 上的 127.0.0.1:17890。
# ---------------------------------------------------------------------------
LINKY_API_BASE_URL=https://linky.kingdee.com/quality-platform/api/linky
LINKY_NETWORK_ACCESS_MODE=DIRECT
LINKY_SYNC_LEASE_SECONDS=900

# 模型访问代理（仅 HOST_PROXY 模式需要；DIRECT 时整段留空）
MODEL_CONNECTIVITY_PROXY_URL=
MODEL_CONNECTIVITY_PROXY_USERNAME=
MODEL_CONNECTIVITY_PROXY_PASSWORD=

# ---------------------------------------------------------------------------
# 运行监控事件上报（保持与现有默认一致）
# ---------------------------------------------------------------------------
RUNTIME_EVENTS_ENABLED=true
RUNTIME_EVENT_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# 受管 Skill 共享缓存（命名卷已在 docker-compose.worker.yml 声明）
# ---------------------------------------------------------------------------
SKILL_CACHE_ROOT=/workspace/skill-cache
SKILL_CACHE_MAX_BYTES=4294967296
