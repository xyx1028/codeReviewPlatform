# 远程 MCP 自部署配置模板（V1.48）
#
# 复制到 mcp/code-review-mcp/.env.selfhost.local（已被 .gitignore 忽略），然后：
#   npm run mcp:start:selfhost
# 或用 systemd：见 deploy/supabase-selfhost/systemd/crp-mcp.service

# ---------------------------------------------------------------------------
# 平台接口地址。两种部署形态选一个：
#   · MCP 作为容器接入 crp-selfhost-net → http://crp-supabase-api:8000
#   · MCP 作为宿主机 systemd 进程      → http://127.0.0.1:54341
# 不要在这里填公司 HTTPS 域名绕一圈回来：多一跳反向代理，故障面更大。
# ---------------------------------------------------------------------------
CRP_SUPABASE_URL=http://127.0.0.1:54341
CRP_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# 代表这台 MCP 的平台账号：专用 REVIEWER 账号，新随机密码，不要复用管理员。
# 角色不够时提交会被 RLS 如实拒绝（不是静默失败）。
# ---------------------------------------------------------------------------
CRP_EMAIL=
CRP_PASSWORD=

# 回执里的平台链接必须是**公司同事能打开**的地址，不能是 localhost 或 Docker 服务名
CRP_PLATFORM_WEB_URL=https://review.corp.example

# 评审模型展示名（平台「模型管理」里已启用且有 API Key 的那个）。
# 平台只有一个可用模型时可留空；配错会在提交时明确失败，不会静默换模型。
CRP_DEFAULT_MODEL=

# ---------------------------------------------------------------------------
# 远程端点。监听回环，由反向代理转发公司域名的 /mcp（见 nginx/mcp.conf）。
# ---------------------------------------------------------------------------
CRP_MCP_TRANSPORT=http
CRP_MCP_HOST=127.0.0.1
CRP_MCP_PORT=8848
CRP_MCP_PATH=/mcp

# 访问凭证：名字:至少16位随机串，逗号分隔。名字只进日志，用来区分谁提交的。
# 生成：node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
CRP_MCP_TOKENS=

# 单次平台请求超时（毫秒）。超时按"结果不明"处理：保留批次并提示去平台确认，
# 绝不会把可能已受理的任务删掉。
CRP_PLATFORM_TIMEOUT_MS=30000

# 批次名前缀
CRP_BATCH_NAME_PREFIX=MCP 评审
