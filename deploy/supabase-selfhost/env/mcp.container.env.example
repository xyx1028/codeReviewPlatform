# Copy to /home/kduser/crp/app/.docker/mcp.selfhost.env; chmod 600.
# Never commit the filled file or paste its contents into a chat.
# CRP_SUPABASE_URL and the MCP listener are set by docker-compose.mcp.yml.
# Use this deployment's public anon key, not its service-role key.
CRP_SUPABASE_ANON_KEY=

# Leave blank for the release script to create/reuse its dedicated REVIEWER
# system account with a random password. Existing custom credentials are kept.
CRP_EMAIL=
CRP_PASSWORD=

# Link returned to users. Use the URL that currently works inside the company.
CRP_PLATFORM_WEB_URL=http://crp-review.kingdee.com

# Initializer resolves the unique Model/name/ID and saves its exact config ID.
CRP_DEFAULT_MODEL=glm5.3-flash

# Read-only Linky lookup before submitting a review; no Linky token is needed.
CRP_LINKY_API_BASE_URL=https://linky.kingdee.com/quality-platform/api/linky

# One or more caller credentials: name:random-token-of-at-least-16-characters
# Leave blank for automatic generation on the first real release.
CRP_MCP_TOKENS=
