VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_WECHAT_LOGIN_ENABLED=false

# ---------------------------------------------------------------------------
# 本机直接跑 Worker（npm run worker:dev）或只读诊断 CLI
# （npm run monitor:attempt / monitor:trend / monitor:findings）时才需要下面这些。
# 容器部署走 .docker/worker.env，不要把两份配置混在一起。
# service-role key 只属于 Worker 与 CLI，绝不能进浏览器构建。
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 运行监控事件上报（V1.5 真实运行监控台）。
# false 时 Worker 完全不上报，现有分析流程不受影响 —— 三级停写手段的第二级。
RUNTIME_EVENTS_ENABLED=true
# Reporter 定时 flush 间隔（毫秒）。同时是工具生命周期的折叠窗口：
# 在这个窗口内闭合的工具只落一条 TERMINAL，不会出现“正在调用”态。
RUNTIME_EVENT_FLUSH_MS=800
# 单 Attempt 队列上限。溢出时先丢已折叠的快工具 TERMINAL，
# *_DENIED / *_FAILED / ATTEMPT / AGENT / JOB / TASK 事件永不丢弃。
RUNTIME_EVENT_QUEUE_MAX=512
# 单批最大事件数。
RUNTIME_EVENT_BATCH_MAX=64
# 事件保留天数。必须与数据库 analysis_runtime_event.retention_until 默认值一致。
# 注意：analysis_agent_run_rollup 不参与清理，跨月趋势对比依赖它。
RUNTIME_EVENT_RETENTION_DAYS=30
