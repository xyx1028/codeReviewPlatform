# Local Docker Worker configuration.
# Copy this file to .docker/worker.env, fill the blank values, and keep that
# real file on this computer only. It is ignored by Git.
# Do not copy WORKER_ID, WORKSPACE_ROOT, CODE_CACHE_ROOT, AGENT_ATTEMPTS_ROOT or
# SKILL_CACHE_ROOT from the host-worker configuration: the image supplies
# its own container-safe paths and Compose generates one ID per container.

# Cloud Supabase connection. The service role is Worker-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Containers do not reuse the macOS Keychain credential helper. Use a GitLab
# Deploy Token belonging to a read-only account with read_repository scope.
GIT_AUTH_MODE=token
GITLAB_BASE_URL=https://git.kingdee.com
GITLAB_DEPLOY_USER=
GITLAB_DEPLOY_TOKEN=

# Runtime tuning. With two replicas, concurrency 2 means four story slots.
POLL_INTERVAL_MS=5000
STORY_TASK_LEASE_SECONDS=900
HEARTBEAT_INTERVAL_MS=30000
WORKER_STORY_CONCURRENCY=2
LOG_LEVEL=info

# V1.7 模型连接测试队列。租约必须大于探测超时（最长 30 秒）。
MODEL_CONNECTIVITY_TEST_LEASE_SECONDS=90

# 公司内网模型只能经 Mac 宿主机的公司网络/VPN 访问，Docker 自身拿不到那条路由。
# 这三项由 scripts/install-model-vpn-proxy.sh 写入真实的 .docker/worker.env；
# 只有模型端点的请求走它，Supabase 与 GitLab 保持直连。
#
# 走不走代理**不由这里决定**，而由模型自己的「网络类型」决定
# （ai_model_config.network_access_mode，页面上选「公网模型 / 内网模型」）：
#   公网模型 DIRECT      → 直连，即使配了代理也不走它；
#   内网模型 HOST_PROXY  → 经这里的代理；这台 Worker 没配代理就以
#                          MODEL_PROXY_NOT_CONFIGURED 明确失败，绝不静默直连。
# 所以：只接公网模型的部署可以整段留空；有内网模型的部署必须配齐三项。
# MODEL_CONNECTIVITY_PROXY_URL=http://host.docker.internal:17890
# MODEL_CONNECTIVITY_PROXY_USERNAME=worker
# MODEL_CONNECTIVITY_PROXY_PASSWORD=

# V1.6 受管 DSH Skill Bundle 的共享只读 cache。
# 路径由 docker-compose.worker.yml 指定为命名卷 /workspace/skill-cache，这里只调容量。
# 回收是无损的（每个 bundle 都能按冻结 locator 重新下载），所以宁可设紧一点，也不要让卷满：
# 卷满会让所有在跑的 attempt 一起失败，而重新下载只多花一次带宽。
# 默认 4 GiB；全目录展开上限是 256 MiB，够同时留住约 16 代不同的技能目录。
SKILL_CACHE_MAX_BYTES=4294967296

# 模型端点是否接受图片输入。默认 false。
# 它决定 attempt 给模型路由声明的模态（llm-pi-ai 的默认值是只有 text）。
# 关掉时技能包里的 assets/*.png 仍然可以发布，但模型读不到 —— read_image 会以
# "model does not declare image input" 被拒（这是实测行为，见
# worker/src/__tests__/v16-skill-dsh-runtime.test.ts）。
# 打开之前必须确认端点真的接受图片：声明了而模型不支持，图片会被发给一个处理不了它的
# provider，那是一次可能拖垮整个 attempt 的上游错误。两个错误的代价不一样。
MODEL_IMAGE_INPUT_ENABLED=false

# 运行监控事件上报（V1.5 真实运行监控台）。
# false 时 Worker 完全不上报，现有分析流程不受影响 —— 这是三级停写手段的第二级。
RUNTIME_EVENTS_ENABLED=true
# Reporter 定时 flush 间隔（毫秒）。同时是工具生命周期的折叠窗口：
# 在这个窗口内闭合的工具只落一条 TERMINAL，不会出现"正在调用"态。
RUNTIME_EVENT_FLUSH_MS=800
# 单 Attempt 队列上限。溢出时先丢已折叠的快工具 TERMINAL，
# *_DENIED / *_FAILED / ATTEMPT / AGENT / JOB / TASK 事件永不丢弃。
RUNTIME_EVENT_QUEUE_MAX=512
# 单批最大事件数。
RUNTIME_EVENT_BATCH_MAX=64
# 事件保留天数。必须与数据库 analysis_runtime_event.retention_until 默认值一致。
# 注意：analysis_agent_run_rollup 不参与清理，跨月趋势对比依赖它。
RUNTIME_EVENT_RETENTION_DAYS=30
