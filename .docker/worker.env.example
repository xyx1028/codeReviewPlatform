# Local Docker Worker configuration.
# Copy this file to .docker/worker.env, fill the blank values, and keep that
# real file on this computer only. It is ignored by Git.
# Do not copy WORKER_ID, WORKSPACE_ROOT, CODE_CACHE_ROOT, or
# AGENT_ATTEMPTS_ROOT from the host-worker configuration: the image supplies
# its own container-safe paths and Compose generates one ID per container.

# Cloud Supabase connection. The service role is Worker-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Containers do not reuse the macOS Keychain credential helper. Use a GitLab
# Deploy Token belonging to a read-only account with read_repository scope.
GIT_AUTH_MODE=token
GITLAB_BASE_URL=https://git.kingdee.com
GITLAB_DEPLOY_USER=
GITLAB_DEPLOY_TOKEN=

# Runtime tuning. With two replicas, concurrency 2 means four story slots.
POLL_INTERVAL_MS=5000
STORY_TASK_LEASE_SECONDS=900
HEARTBEAT_INTERVAL_MS=30000
WORKER_STORY_CONCURRENCY=2
LOG_LEVEL=info
